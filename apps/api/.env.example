# Copy to apps/api/.env for local development.
# In production set these as real environment variables / secrets instead —
# never commit a .env file.

# --- required ---------------------------------------------------------------

# Where the SQLite database lives. In production point this at a persistent
# volume (e.g. file:/data/pman.db), otherwise every deploy wipes the data.
DATABASE_URL="file:./prisma/dev.db"

# Signs session tokens. The server REFUSES TO BOOT in production if this is
# missing, short, or left at a default. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me"

# --- optional ---------------------------------------------------------------

# Port to listen on (default 4000).
# PORT=4000

# Persistent directory for uploaded files (payment screenshots, lease docs).
# Defaults to ./uploads. Must be on a volume in production.
# UPLOADS_DIR="/data/uploads"

# Comma-separated browser origins allowed to call the API. The mobile app does
# not need this (native requests carry no Origin). Leave empty in production to
# block all browser origins; set it to serve a web build.
# CORS_ORIGIN="https://d3d34d.github.io"

# Email delivery. Defaults to a console transport that just logs the message.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="PMAN <noreply@yourdomain.com>"

# Card gateway. Deferred in v1 — the app uses submit-proof-and-approve instead.
# PAYMENT_PROVIDER="mock"
