# Copy to apps/mobile/.env to point the app at a specific API.
#
# Expo inlines EXPO_PUBLIC_* variables into the bundle at build time, so after
# changing this you must RESTART Metro (and sometimes `npx expo start --clear`).
#
# Leave this file absent for normal local development: the app then derives the
# API host from whatever machine is serving the bundle, so a phone on the same
# Wi-Fi reaches your dev server with no configuration.

# Point Expo Go / a dev build at your deployed API to verify it end to end.
# Must be https:// with no trailing slash.
# EXPO_PUBLIC_API_URL="https://your-app.fly.dev"

# Set to 1 to run the self-contained in-browser demo backend instead of a real
# API (this is what the GitHub Pages build uses). Not for device testing.
# EXPO_PUBLIC_DEMO=1
