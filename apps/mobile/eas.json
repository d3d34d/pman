{
  "cli": {
    "version": ">= 12.0.0",
    "//": "Local version source: versionCode lives in app.json, tracked in git and visible in diffs. Remote + autoIncrement silently produced versionCode 2 twice, which Play then rejected as already used. Bump android.versionCode by hand for every Play upload.",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pman-api.fly.dev"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pman-api.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
